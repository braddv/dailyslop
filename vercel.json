{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/sp500ad",
      "destination": "/public/sp500ad/index.html"
    },
    {
      "source": "/sp500ad/:path*",
      "destination": "/public/sp500ad/:path*"
    },
    {
      "source": "/smallcaps",
      "destination": "/public/smallcaps/index.html"
    },
    {
      "source": "/smallcaps/:path*",
      "destination": "/public/smallcaps/:path*"
    },
    {
      "source": "/intermarket",
      "destination": "/public/intermarket/index.html"
    },
    {
      "source": "/intermarket/:path*",
      "destination": "/public/intermarket/:path*"
    },
    {
      "source": "/regime",
      "destination": "/public/regime/index.html"
    },
    {
      "source": "/regime/:path*",
      "destination": "/public/regime/:path*"
    },
    {
      "source": "/sectoral-balances",
      "destination": "/public/sectoral-balances/index.html"
    },
    {
      "source": "/sectoral-balances/:path*",
      "destination": "/public/sectoral-balances/:path*"
    },
    {
      "source": "/playbook",
      "destination": "/public/playbook/index.html"
    },
    {
      "source": "/playbook/:path*",
      "destination": "/public/playbook/:path*"
    },
    {
      "source": "/godley",
      "destination": "/public/godley/index.html"
    },
    {
      "source": "/godley/:path*",
      "destination": "/public/godley/:path*"
    },
    {
      "source": "/job-guarantee",
      "destination": "/public/job-guarantee/index.html"
    },
    {
      "source": "/job-guarantee/:path*",
      "destination": "/public/job-guarantee/:path*"
    },
    {
      "source": "/job-bank-atlas",
      "destination": "/public/job-bank-atlas/index.html"
    },
    {
      "source": "/job-bank-atlas/:path*",
      "destination": "/public/job-bank-atlas/:path*"
    },
    {
      "source": "/slop",
      "destination": "/public/slop.html"
    },
    {
      "source": "/slop1",
      "destination": "/public/slop1.html"
    },
    {
      "source": "/slop2",
      "destination": "/public/slop2.html"
    },
    {
      "source": "/slop3",
      "destination": "/public/slop3.html"
    },
    {
      "source": "/slop4",
      "destination": "/public/slop4.html"
    },
    {
      "source": "/slop5",
      "destination": "/public/slop5.html"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/public/:path*"
    }
  ],
  "headers": [
    {
      "source": "/dailyslop.mp4",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
